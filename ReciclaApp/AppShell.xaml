<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReciclaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
     xmlns:pages="clr-namespace:ReciclaApp.Pages"
    xmlns:local="clr-namespace:ReciclaApp"
    Title="ReciclaApp"
         Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       FlyoutBehavior="Disabled">

    <!-- Pantalla inicial -->
    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- Raíz posterior al inicio de sesión -->
    <ShellContent
        Title="Registros"
        Route="registros"
        ContentTemplate="{DataTemplate pages:RegistrosPage}" />

</Shell>