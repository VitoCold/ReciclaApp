<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.DetalleRegistroDetallePage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*,Auto">
            <Label Text="‹" TextColor="White" FontSize="30" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Detalle del registro" Style="{StaticResource HeaderTitle}" />
            <Label Grid.Column="2" Text="⋮" TextColor="White" FontSize="22" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" BackgroundColor="White" ColumnDefinitions="*,*,*" HeightRequest="48">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Fill">
                <Label Text="Detalle" Style="{StaticResource ActiveTabLabel}" VerticalOptions="CenterAndExpand" />
                <BoxView HeightRequest="3" Color="{StaticResource ColorPrimary}" CornerRadius="2" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="Residuos" Style="{StaticResource TabLabel}" />
            <Label Grid.Column="2" Text="Disposición" Style="{StaticResource TabLabel}" />
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="18,18,18,24" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Información general" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="18">
                            <Label Text="📅" TextColor="{StaticResource ColorAccent}" FontSize="18" />
                            <Label Grid.Column="1" Text="Fecha:" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Grid.Column="2" Text="30/06/2026 14:01" TextColor="{StaticResource ColorText}" />

                            <Label Grid.Row="1" Text="👤" TextColor="{StaticResource ColorAccent}" FontSize="18" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Registrado por:" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Grid.Row="1" Grid.Column="2" Text="Juan Pérez" TextColor="{StaticResource ColorText}" />

                            <Label Grid.Row="2" Text="📁" TextColor="{StaticResource ColorAccent}" FontSize="18" />
                            <Label Grid.Row="2" Grid.Column="1" Text="Proyecto:" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Grid.Row="2" Grid.Column="2" Text="DOT" TextColor="{StaticResource ColorText}" />

                            <Label Grid.Row="3" Text="🛠" TextColor="{StaticResource ColorAccent}" FontSize="18" />
                            <Label Grid.Row="3" Grid.Column="1" Text="Actividad:" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Grid.Row="3" Grid.Column="2" Text="Mantenimiento" TextColor="{StaticResource ColorText}" />

                            <Label Grid.Row="4" Text="📍" TextColor="{StaticResource ColorAccent}" FontSize="18" />
                            <Label Grid.Row="4" Grid.Column="1" Text="Sede:" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Grid.Row="4" Grid.Column="2" Text="Pisco" TextColor="{StaticResource ColorText}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
