<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.DetalleRegistroDisposicionPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*">
            <Label Text="‹"
                   TextColor="White"
                   FontSize="30"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Text="Detalle del registro"
                   Style="{StaticResource HeaderTitle}" />
        </Grid>

        <Grid Grid.Row="1"
              BackgroundColor="White"
              ColumnDefinitions="*,*,*"
              HeightRequest="48">
            <Label Text="Detalle"
                   Style="{StaticResource TabLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDetalleTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Residuos"
                   Style="{StaticResource TabLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResiduosTapped" />
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Fill">
                <Label Text="Disposición"
                       Style="{StaticResource ActiveTabLabel}"
                       VerticalOptions="CenterAndExpand" />
                <BoxView HeightRequest="3"
                         Color="{StaticResource ColorPrimary}"
                         CornerRadius="2" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,24" Spacing="14">
                    <Border x:Name="ErrorBorder"
                            IsVisible="False"
                            BackgroundColor="{StaticResource ColorDangerSoft}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Label x:Name="ErrorLabel"
                               Text="No se pudo cargar la disposición."
                               TextColor="{StaticResource ColorDanger}"
                               FontSize="12" />
                    </Border>

                    <VerticalStackLayout x:Name="SinDisposicionView"
                                         IsVisible="False"
                                         Padding="12,34"
                                         Spacing="10"
                                         HorizontalOptions="Center">
                        <Border Style="{StaticResource IconCircle}"
                                WidthRequest="64"
                                HeightRequest="64"
                                HorizontalOptions="Center">
                            <Label Text="📦"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Sin disposición registrada"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorText}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Este registro todavía no tiene información de disposición final."
                               Style="{StaticResource MutedText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="DisposicionView"
                                         IsVisible="False"
                                         Spacing="14">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Información de disposición"
                                       Style="{StaticResource SectionTitle}" />

                                <Grid ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="14">
                                    <Label Text="📄" FontSize="18" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Documento" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                        <Label x:Name="DocumentoLabel" Text="-" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Row="1" Text="📅" FontSize="18" />
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Fecha" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                        <Label x:Name="FechaDisposicionLabel" Text="-" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Row="2" Text="🏭" FontSize="18" />
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <Label Text="Empresa" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                        <Label x:Name="EmpresaLabel" Text="-" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Row="3" Text="📝" FontSize="18" />
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                                        <Label Text="Observación" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                        <Label x:Name="ObservacionLabel" Text="-" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Evidencias"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource Chip}"
                                    BackgroundColor="{StaticResource ColorBlueSoft}">
                                <Label x:Name="CantidadEvidenciasLabel"
                                       Text="0 evidencias"
                                       TextColor="{StaticResource ColorPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="11" />
                            </Border>
                        </Grid>

                        <CollectionView x:Name="EvidenciasCollectionView"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No hay evidencias adjuntas."
                                       Style="{StaticResource MutedText}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,18" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SoftCard}"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="📎" FontSize="20" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding NombreArchivo}"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource ColorText}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding TipoEvidencia}"
                                                       Style="{StaticResource TinyMutedText}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding CreadoUtc, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                   Style="{StaticResource TinyMutedText}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator x:Name="DisposicionActivityIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
