<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.InicioRegistroPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*">
            <Label Text="‹" TextColor="White" FontSize="30" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Inicio de registro" Style="{StaticResource HeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,34,18,24" Spacing="22">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border Style="{StaticResource IconCircle}" HorizontalOptions="Center" WidthRequest="64" HeightRequest="64">
                        <Label Text="📋" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Completa la información&#10;para iniciar el registro" HorizontalTextAlignment="Center" TextColor="{StaticResource ColorText}" FontAttributes="Bold" FontSize="15" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="📁" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Proyecto" Style="{StaticResource FieldLabel}" />
                                <Picker x:Name="ProyectoPicker"
                                        Title="Selecciona un proyecto"
                                        FontSize="12"
                                        TextColor="{StaticResource ColorText}"
                                        TitleColor="{StaticResource ColorMuted}"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32">
                                    <Picker.Items>
                                        <x:String>DOT</x:String>
                                        <x:String>Proyecto Norte</x:String>
                                        <x:String>Proyecto Sur</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="🛠" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Actividad" Style="{StaticResource FieldLabel}" />
                                <Picker x:Name="ActividadPicker"
                                        Title="Selecciona una actividad"
                                        FontSize="12"
                                        TextColor="{StaticResource ColorText}"
                                        TitleColor="{StaticResource ColorMuted}"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32">
                                    <Picker.Items>
                                        <x:String>Mantenimiento</x:String>
                                        <x:String>Administración</x:String>
                                        <x:String>Limpieza</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="📍" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Sede" Style="{StaticResource FieldLabel}" />
                                <Picker x:Name="SedePicker"
                                        Title="Selecciona una sede"
                                        FontSize="12"
                                        TextColor="{StaticResource ColorText}"
                                        TitleColor="{StaticResource ColorMuted}"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32">
                                    <Picker.Items>
                                        <x:String>Pisco</x:String>
                                        <x:String>Lima</x:String>
                                        <x:String>Arequipa</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Continuar  →"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnContinuarClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
