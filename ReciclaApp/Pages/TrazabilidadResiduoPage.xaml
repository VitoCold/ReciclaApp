<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.TrazabilidadResiduoPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*">
            <Label Text="‹" TextColor="White" FontSize="34" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Trazabilidad del residuo" Style="{StaticResource HeaderTitle}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,34" Spacing="14">
                <Border x:Name="ErrorBorder" IsVisible="False"
                        BackgroundColor="{StaticResource ColorDangerSoft}"
                        Stroke="Transparent" StrokeShape="RoundRectangle 12"
                        Padding="12,9">
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource ColorDanger}" FontSize="12" />
                </Border>

                <ActivityIndicator x:Name="ActivityIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   HorizontalOptions="Center" />

                <VerticalStackLayout x:Name="ContenidoLayout" IsVisible="False" Spacing="14">
                    <Border Style="{StaticResource SoftCard}">
                        <VerticalStackLayout Spacing="5">
                            <Label x:Name="ResiduoLabel" Style="{StaticResource PageTitle}" FontSize="22" />
                            <Label x:Name="ClasificacionLabel" Style="{StaticResource MutedText}" />
                            <Label x:Name="OrigenLabel" FontSize="12" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="CantidadLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,4" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label x:Name="EstadoLabel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                <Label x:Name="CierreLabel" Grid.Column="1" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Línea de tiempo" Style="{StaticResource SectionTitle}" />
                        <Label Text="Historia operativa y documental del residuo, sin perder los eventos cerrados."
                               Style="{StaticResource TinyMutedText}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Eventos}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="42,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.RowSpan="2" Spacing="0" HorizontalOptions="Center">
                                            <Border WidthRequest="36" HeightRequest="36"
                                                    BackgroundColor="{StaticResource ColorBlueSoft}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 18">
                                                <Label Text="{Binding Icono}" FontSize="16"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <BoxView WidthRequest="2" HeightRequest="26"
                                                     BackgroundColor="#D9E2EC"
                                                     HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1" Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Titulo}" FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource ColorText}" />
                                                    <Label Grid.Column="1" Text="{Binding Estado}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource ColorPrimary}" />
                                                </Grid>
                                                <Label Text="{Binding FechaTexto}" Style="{StaticResource TinyMutedText}" />
                                                <Label Text="{Binding CantidadTexto}" FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource ColorPrimary}" />
                                                <Label Text="{Binding Detalle}" FontSize="11"
                                                       TextColor="{StaticResource ColorMuted}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
