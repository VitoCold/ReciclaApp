<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.AdministracionPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*,Auto">
            <Label Text="☰" TextColor="White" FontSize="24" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Administración" Style="{StaticResource HeaderTitle}" />
            <Label Grid.Column="2" Text="⚙" TextColor="White" FontSize="18" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,34" Spacing="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Maestros y configuración" Style="{StaticResource PageTitle}" FontSize="22" />
                    <Label Text="Configura los datos que alimentan la operación de GIRA." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource SoftCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUsuariosTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                        <Label Text="👥" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Usuarios" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Text="Roles, sedes, estado y acceso" Style="{StaticResource TinyMutedText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Administrar ›" TextColor="{StaticResource ColorPrimary}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="Siguiente ola" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource SoftCard}">
                    <Grid ColumnDefinitions="44,*">
                        <Label Text="🏢" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Sedes y puntos de residuo" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Text="Pendiente · generación, almacenamiento y ambos" Style="{StaticResource TinyMutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SoftCard}">
                    <Grid ColumnDefinitions="44,*">
                        <Label Text="📁" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Proyectos y actividades" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Text="Pendiente · estructura operativa de los controles" Style="{StaticResource TinyMutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SoftCard}">
                    <Grid ColumnDefinitions="44,*">
                        <Label Text="♻️" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Tipos y catálogo de residuos" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Text="Pendiente · clasificación y unidad predeterminada" Style="{StaticResource TinyMutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SoftCard}">
                    <Grid ColumnDefinitions="44,*">
                        <Label Text="🚛" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="EO-RS / Empresas" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            <Label Text="Pendiente · datos y autorización de gestores" Style="{StaticResource TinyMutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>