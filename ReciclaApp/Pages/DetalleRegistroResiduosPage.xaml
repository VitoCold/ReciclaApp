<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.DetalleRegistroResiduosPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*,Auto">
            <Label Text="‹"
                   TextColor="White"
                   FontSize="30"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Text="Detalle del registro"
                   Style="{StaticResource HeaderTitle}" />
            <Label x:Name="CantidadHeaderLabel"
                   Grid.Column="2"
                   Text="0 residuos"
                   TextColor="White"
                   FontSize="11"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1"
              BackgroundColor="White"
              ColumnDefinitions="*,*,*"
              HeightRequest="48">
            <Label Text="Detalle"
                   Style="{StaticResource TabLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDetalleTapped" />
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Fill">
                <Label Text="Residuos"
                       Style="{StaticResource ActiveTabLabel}"
                       VerticalOptions="CenterAndExpand" />
                <BoxView HeightRequest="3"
                         Color="{StaticResource ColorPrimary}"
                         CornerRadius="2" />
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="Disposición"
                   Style="{StaticResource TabLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDisposicionTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Grid Grid.Row="2"
              Padding="16,16,16,24"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">
            <Button Grid.Row="0"
                    Text="＋ Agregar residuo"
                    Style="{StaticResource SmallPrimaryButton}"
                    HorizontalOptions="Start"
                    Clicked="OnAgregarResiduoClicked" />

            <Border x:Name="ErrorBorder"
                    Grid.Row="1"
                    IsVisible="False"
                    BackgroundColor="{StaticResource ColorDangerSoft}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">
                <Label x:Name="ErrorLabel"
                       Text="No se pudieron cargar los residuos."
                       TextColor="{StaticResource ColorDanger}"
                       FontSize="12" />
            </Border>

            <Grid Grid.Row="2">
                <RefreshView x:Name="ResiduosRefreshView"
                             Refreshing="OnRefreshRequested">
                    <CollectionView x:Name="ResiduosCollectionView"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,42"
                                                 Spacing="10"
                                                 HorizontalOptions="Center">
                                <Border Style="{StaticResource IconCircle}"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        HorizontalOptions="Center">
                                    <Label Text="♻"
                                           FontSize="28"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label Text="Aún no hay residuos"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource ColorText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Agrega al menos un residuo para completar el registro."
                                       Style="{StaticResource MutedText}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCard}"
                                        Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12">
                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="{Binding ClasificacionFondo}"
                                                Stroke="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="♻"
                                                   FontSize="23"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource ColorText}" />
                                            <Label Text="{Binding Clasificacion}"
                                                   TextColor="{Binding ClasificacionColor}"
                                                   FontAttributes="Bold"
                                                   FontSize="12" />
                                            <Label Text="{Binding Observacion}"
                                                   Style="{StaticResource TinyMutedText}"
                                                   LineBreakMode="TailTruncation"
                                                   IsVisible="{Binding TieneObservacion}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="3"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding CantidadTexto}"
                                                   TextColor="{StaticResource ColorText}"
                                                   FontAttributes="Bold"
                                                   FontSize="12"
                                                   HorizontalOptions="End" />
                                            <Label Text="{Binding FotosTexto}"
                                                   TextColor="{StaticResource ColorMuted}"
                                                   FontSize="10"
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <ActivityIndicator x:Name="ResiduosActivityIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
