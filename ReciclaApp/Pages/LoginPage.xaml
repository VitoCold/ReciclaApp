<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.LoginPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,28" RowDefinitions="Auto,*">
            <VerticalStackLayout Grid.Row="0" Spacing="22" VerticalOptions="Center">

                <Grid HeightRequest="188">
                    <Ellipse Fill="#E8F7EF" WidthRequest="148" HeightRequest="148" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Ellipse Fill="#D9ECFF" WidthRequest="104" HeightRequest="104" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="♻" FontSize="70" TextColor="{StaticResource ColorAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="🌿" FontSize="38" HorizontalOptions="Start" VerticalOptions="End" Margin="46,0,0,24" />
                    <Label Text="🌱" FontSize="34" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,48,24" />
                </Grid>

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Gestión de Residuos" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="Registro y control de residuos sólidos" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="👤" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Usuario" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                <Entry Placeholder="Ingresa tu usuario" ClearButtonVisibility="WhileEditing" BackgroundColor="Transparent" FontSize="13" HeightRequest="34" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="🔒" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Clave" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ColorText}" />
                                <Entry Placeholder="Ingresa tu clave" IsPassword="True" BackgroundColor="Transparent" FontSize="13" HeightRequest="34" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="◉" TextColor="{StaticResource ColorMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Iniciar sesión"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnLoginClicked" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,8,0,0">
                    <Label Text="🔐" FontSize="13" />
                    <Label Text="Acceso seguro y protegido" Style="{StaticResource MutedText}" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
