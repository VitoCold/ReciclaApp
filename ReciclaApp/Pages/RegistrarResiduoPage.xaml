<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.RegistrarResiduoPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*">
            <Label Text="‹" TextColor="White" FontSize="30" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Registrar residuo" Style="{StaticResource HeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,34,18,24" Spacing="22">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border Style="{StaticResource IconCircle}" HorizontalOptions="Center" WidthRequest="64" HeightRequest="64">
                        <Label Text="🗑" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Información del residuo" HorizontalTextAlignment="Center" TextColor="{StaticResource ColorText}" FontAttributes="Bold" FontSize="17" />
                    <Label Text="Completa los datos del residuo generado" HorizontalTextAlignment="Center" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Tipo de residuo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                <Label Text="Selecciona el tipo" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="⌄" FontSize="18" TextColor="{StaticResource ColorMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Residuo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                <Label Text="Selecciona el residuo" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="⌄" FontSize="18" TextColor="{StaticResource ColorMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Cantidad (kg)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                <Entry Placeholder="Ingresa la cantidad" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="13" HeightRequest="34" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="12,8" BackgroundColor="#F1F5F9" Stroke="Transparent" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="kg" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Registrar residuo  →" Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
