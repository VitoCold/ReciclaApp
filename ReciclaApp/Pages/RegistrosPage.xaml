<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.RegistrosPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*,Auto,Auto">
            <Label Text="☰" TextColor="White" FontSize="24" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Label Text="📅" FontSize="14" />
                <Label Text="30/06/2026" TextColor="White" FontAttributes="Bold" FontSize="14" />
            </HorizontalStackLayout>
            <Label Grid.Column="2" Text="Juan Pérez" TextColor="White" FontSize="13" VerticalOptions="Center" />
            <Border Grid.Column="3" WidthRequest="30" HeightRequest="30" BackgroundColor="#DDEEFF" Stroke="Transparent">
                <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                <Label Text="👤" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,24" Spacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Mis registros" Style="{StaticResource PageTitle}" FontSize="22" />
                    <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorSuccessSoft}" VerticalOptions="Center">
                        <Label Text="8 registros" TextColor="{StaticResource ColorAccent}" FontAttributes="Bold" FontSize="12" />
                    </Border>
                </Grid>

                <Button Text="＋ Nuevo registro" Style="{StaticResource PrimaryButton}" />

                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource SoftCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="📅" FontSize="18" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="30/06/2026 14:01" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource ColorText}" />
                                <Label Text="Registro de residuos en mantenimiento de equipos." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End">
                                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorSuccessSoft}">
                                    <Label Text="Completado" TextColor="{StaticResource ColorAccent}" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Label Text="Ver detalle ›" TextColor="{StaticResource ColorPrimary}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SoftCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="📅" FontSize="18" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="28/06/2026 10:35" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource ColorText}" />
                                <Label Text="Recolección de residuos de área administrativa." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End">
                                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorBlueSoft}">
                                    <Label Text="Completado" TextColor="{StaticResource ColorPrimary}" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Label Text="Ver detalle ›" TextColor="{StaticResource ColorPrimary}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SoftCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="📅" FontSize="18" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="27/06/2026 16:45" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource ColorText}" />
                                <Label Text="Generación de residuos en taller mecánico." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End">
                                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorBlueSoft}">
                                    <Label Text="Completado" TextColor="{StaticResource ColorPrimary}" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Label Text="Ver detalle ›" TextColor="{StaticResource ColorPrimary}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SoftCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="📅" FontSize="18" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="25/06/2026 09:20" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource ColorText}" />
                                <Label Text="Limpieza general de instalaciones." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End">
                                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorBlueSoft}">
                                    <Label Text="Completado" TextColor="{StaticResource ColorPrimary}" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Label Text="Ver detalle ›" TextColor="{StaticResource ColorPrimary}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Ver más registros  ⌄" TextColor="{StaticResource ColorPrimary}" FontAttributes="Bold" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
