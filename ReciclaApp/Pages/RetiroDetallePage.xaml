<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.RetiroDetallePage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*">
            <Label Text="‹" TextColor="White" FontSize="34" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Detalle del retiro" Style="{StaticResource HeaderTitle}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,34" Spacing="14">
                <Border x:Name="ErrorBorder" IsVisible="False" BackgroundColor="{StaticResource ColorDangerSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="12,9">
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource ColorDanger}" FontSize="12" />
                </Border>

                <ActivityIndicator x:Name="ActivityIndicator" IsVisible="False" IsRunning="False" HorizontalOptions="Center" />

                <VerticalStackLayout x:Name="ContenidoLayout" IsVisible="False" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="CodigoLabel" Text="RET-000" Style="{StaticResource PageTitle}" FontSize="22" />
                            <Label x:Name="FechaLabel" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorGreenSoft}" VerticalOptions="Center">
                            <Label x:Name="EstadoLabel" Text="Retirado" TextColor="{StaticResource ColorSuccess}" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SoftCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Salida" Style="{StaticResource SectionTitle}" />
                            <Label x:Name="UbicacionLabel" FontSize="13" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="GestorLabel" FontSize="13" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="TotalesLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                            <Label x:Name="CreadoPorLabel" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SoftCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Transporte" Style="{StaticResource SectionTitle}" />
                            <Label x:Name="DocumentoLabel" FontSize="12" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="VehiculoLabel" FontSize="12" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="ConductorLabel" FontSize="12" TextColor="{StaticResource ColorText}" />
                            <Label x:Name="ObservacionLabel" FontSize="12" TextColor="{StaticResource ColorMuted}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SoftCard}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Residuos retirados" Style="{StaticResource SectionTitle}" />
                                <Label x:Name="CantidadLabel" Grid.Column="1" Style="{StaticResource TinyMutedText}" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detalles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Residuo}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                                <Label Text="{Binding OrigenTexto}" FontSize="10" TextColor="{StaticResource ColorMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding CantidadTexto}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
