<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReciclaApp.Pages.StockResiduosPage"
             Style="{StaticResource BasePage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Style="{StaticResource AppHeader}" ColumnDefinitions="Auto,*,Auto,Auto">
            <Label Text="☰" TextColor="White" FontSize="24" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Stock de residuos" Style="{StaticResource HeaderTitle}" />
            <Label x:Name="UsuarioHeaderLabel" Grid.Column="2" Text="Usuario" TextColor="White" FontSize="12" VerticalOptions="Center" />
            <Border Grid.Column="3" WidthRequest="30" HeightRequest="30" BackgroundColor="#DDEEFF" Stroke="Transparent" StrokeShape="RoundRectangle 15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped" />
                </Border.GestureRecognizers>
                <Label Text="👤" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Padding="18,18,18,24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Inventario disponible" Style="{StaticResource PageTitle}" FontSize="22" />
                    <Label Text="Residuos registrados pendientes de retiro" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource SoftCard}" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Sede" Style="{StaticResource TinyMutedText}" VerticalOptions="Center" />
                        <Picker x:Name="SedePicker"
                                Grid.Column="1"
                                Title="Todas las sedes"
                                ItemDisplayBinding="{Binding Nombre}"
                                SelectedIndexChanged="OnSedeChanged" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1" BackgroundColor="{StaticResource ColorBlueSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="12,10">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Saldo visible" FontSize="11" TextColor="{StaticResource ColorMuted}" />
                    <Label x:Name="ResumenLabel" Text="Sin stock disponible" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ErrorBorder" Grid.Row="2" IsVisible="False" BackgroundColor="{StaticResource ColorDangerSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="12,9">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource ColorDanger}" FontSize="12" />
                    <Label Grid.Column="1" Text="Reintentar" TextColor="{StaticResource ColorPrimary}" FontAttributes="Bold" FontSize="12">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReintentarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <RefreshView x:Name="StockRefreshView" Refreshing="OnRefreshRequested">
                    <CollectionView x:Name="StockCollectionView" SelectionMode="None" ItemsLayout="VerticalList">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,44" Spacing="10" HorizontalOptions="Center">
                                <Border Style="{StaticResource IconCircle}" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="No hay stock disponible" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorText}" HorizontalTextAlignment="Center" />
                                <Label Text="Los residuos aparecerán aquí cuando sus registros sean finalizados." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Residuo}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorText}" />
                                                <Label Text="{Binding Clasificacion}" FontSize="11" TextColor="{StaticResource ColorMuted}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource ColorBlueSoft}" VerticalOptions="Start">
                                                <Label Text="{Binding DisponibleTexto}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding OrigenTexto}" FontSize="11" TextColor="{StaticResource ColorMuted}" />
                                        <Label Text="{Binding RegistroTexto}" FontSize="11" TextColor="{StaticResource ColorMuted}" />

                                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                            <Label Text="Pendiente" Style="{StaticResource TinyMutedText}" />
                                            <Label Grid.Column="1" Text="{Binding PendienteTexto}" FontSize="12" TextColor="{StaticResource ColorText}" />
                                            <Label Grid.Row="1" Text="Almacenado" Style="{StaticResource TinyMutedText}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding AlmacenamientosTexto}" FontSize="12" TextColor="{StaticResource ColorText}" />
                                        </Grid>

                                        <Button Text="Enviar a almacenamiento"
                                                Style="{StaticResource SmallPrimaryButton}"
                                                IsVisible="{Binding PuedeAlmacenar}"
                                                CommandParameter="{Binding RegistroResiduoId}"
                                                Clicked="OnAlmacenarClicked" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <ActivityIndicator x:Name="ActivityIndicator" IsVisible="False" IsRunning="False" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
