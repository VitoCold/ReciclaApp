<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Alias faltantes usados por las pantallas -->
    <Color x:Key="ColorPrimary">#0753B7</Color>
    <Color x:Key="ColorAccent">#079542</Color>
    <Color x:Key="ColorText">#12213B</Color>
    <Color x:Key="ColorMuted">#5B667A</Color>
    <Color x:Key="ColorBorder">#E3E8F0</Color>
    <Color x:Key="ColorSuccessSoft">#E8F7EE</Color>
    <Color x:Key="ColorBlueSoft">#EAF2FF</Color>
    <Color x:Key="ColorDanger">#E4312B</Color>
    <Color x:Key="ColorDangerSoft">#FFE9E7</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorWarningSoft">#FFF4DC</Color>

    <Style x:Key="BasePage"
           TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="#F7FAF8" />
    </Style>

    <Style x:Key="AppHeader"
           TargetType="Grid">
        <Setter Property="BackgroundColor"
                Value="{StaticResource ColorPrimary}" />
        <Setter Property="Padding"
                Value="16,8" />
        <Setter Property="HeightRequest"
                Value="64" />
        <Setter Property="ColumnSpacing"
                Value="10" />
    </Style>

    <Style x:Key="PageTitle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource ColorText}" />
    </Style>

    <Style x:Key="HeaderTitle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="17" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="White" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="TabLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource ColorMuted}" />
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="ActiveTabLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource ColorPrimary}" />
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="InputBorder"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="White" />
        <Setter Property="Stroke"
                Value="{StaticResource ColorBorder}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 14" />
        <Setter Property="Padding"
                Value="14,8" />
    </Style>

    <Style x:Key="SoftCard"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="White" />
        <Setter Property="Stroke"
                Value="{StaticResource ColorBorder}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 18" />
        <Setter Property="Padding"
                Value="14" />
    </Style>

    <Style x:Key="Chip"
           TargetType="Border">
        <Setter Property="Stroke"
                Value="Transparent" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 14" />
        <Setter Property="Padding"
                Value="9,4" />
    </Style>

    <Style x:Key="SmallPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SmallGreenButton}" />

    <Style x:Key="IconCircle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource ColorSuccessSoft}" />
        <Setter Property="Stroke"
                Value="Transparent" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 32" />
    </Style>

    <Style x:Key="TinyMutedText"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="TextColor"
                Value="{StaticResource ColorMuted}" />
    </Style>

</ResourceDictionary>
